generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Goal {
  id          Int      @id @default(autoincrement())
  name        String
  tasks       Task[]
  description String
  status      Status
  createdAt   DateTime @default(now())
  userId      String
}

model Task {
  id        Int      @id @default(autoincrement())
  name      String
  goalId    Int
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  status    Status
}

enum Status {
  TODO
  DONE
}
